#include <stdio.h>

int main() {
    
    int Bispo = 5;
    int Torre = 5;
    int Rainha = 8;
    int Cavalo = 2;
    
    printf("Movimentação Bispo\n");
    for (int b = 0; b < Bispo; b++) {
        printf("Direita, Cima\n");
    }
    
    printf("\nMovimentação Torre\n");
    int t = 0;
    while(t < Torre) {
        printf("Direita\n");
        t++;
    }
    
    printf("\nMovimentação Rainha\n"); // Adicionado \n
    int r = 0;
    do { 
        printf("Esquerda\n");
        r++;
    } while(r < Rainha);
    
    printf("\nMovimentação Cavalo\n"); 
    for (int c = 0; c < Cavalo; c++) { 
        for(int i = 0; i < 2; i++) { 
            printf("Cima\n");
        }
        printf("Direita\n");
    }
    
    return 0;
}
